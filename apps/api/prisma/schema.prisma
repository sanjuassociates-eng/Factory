generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl is used by Prisma Migrate (bypasses the pooler).
  // Set this to Neon's direct (non-pooled) connection string.
  directUrl = env("DIRECT_URL")
}

enum VehicleStatus {
  REGISTERED
  PICKED_UP
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum StockAdjustmentType {
  DAMAGE
  WASTAGE
  RETURN
  CORRECTION
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  permissions  String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  productionLogs    ProductionLog[]
  vehicles          Vehicle[]       @relation("VehicleRegisteredBy")
  buyersCreated     Buyer[]         @relation("BuyerCreatedBy")
  auditLogs         AuditLog[]
  stockAdjustments  StockAdjustment[]
}

model Product {
  id        String   @id @default(cuid())
  name      String
  grade     String
  unit      String   @default("MT")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productionLogs    ProductionLog[]
  vehicleItems      VehicleItem[]
  stockAdjustments  StockAdjustment[]
}

model ProductionLog {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  tonnage      Float
  pricePerUnit Float    @default(0)
  date         DateTime @db.Date
  operatorId   String
  operator     User     @relation(fields: [operatorId], references: [id])
  notes        String?
  createdAt    DateTime @default(now())

  @@index([date])
  @@index([productId])
}

model Buyer {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  address   String?
  createdBy String
  creator   User     @relation("BuyerCreatedBy", fields: [createdBy], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles Vehicle[]
}

model Vehicle {
  id            String        @id @default(cuid())
  buyerId       String
  buyer         Buyer         @relation(fields: [buyerId], references: [id])
  vehicleNumber String
  driverName    String?
  driverPhone   String?
  status        VehicleStatus @default(REGISTERED)
  registeredBy  String
  registrar     User          @relation("VehicleRegisteredBy", fields: [registeredBy], references: [id])
  pickedUpAt    DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items VehicleItem[]

  @@index([buyerId])
  @@index([status])
}

model VehicleItem {
  id           String  @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  tonnage      Float
  pricePerUnit Float   @default(0)

  @@index([vehicleId])
  @@index([productId])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  action    AuditAction
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime    @default(now())

  @@index([entity])
  @@index([userId])
  @@index([createdAt])
}

model StockAdjustment {
  id        String              @id @default(cuid())
  productId String
  product   Product             @relation(fields: [productId], references: [id])
  tonnage   Float               // negative = reduction (damage/wastage), positive = addition (return/correction)
  type      StockAdjustmentType
  reason    String
  date      DateTime            @db.Date
  createdBy String
  creator   User                @relation(fields: [createdBy], references: [id])
  notes     String?
  createdAt DateTime            @default(now())

  @@index([productId])
  @@index([date])
  @@index([createdBy])
}
